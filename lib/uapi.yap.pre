

#include <asm/stat.h>
#include <asm/fcntl.h>
#include <linux/fs.h>
#include <netinet/in.h>

#include "dirent.h"


seq FS::Struct::Stat
{
    MODE = `offsetof(struct stat, st_mode)`,
    SIZE = `offsetof(struct stat, st_size)`,
}

seq FS::Struct::Dirent
{
    RECLEN = `offsetof(struct linux_dirent, d_reclen)`,
    NAME   = `offsetof(struct linux_dirent, d_name)`,
}

seq FS::Mode
{
    RDONLY = `O_RDONLY`,
    WRONLY = `O_WRONLY`,
    RDWR   = `O_RDWR`,
    CREATE = `O_CREAT`,
    TRUNC  = `O_TRUNC`,
}

seq FS::Seek::Mode
{
    SEEK_SET = `SEEK_SET`,
    SEEK_CUR = `SEEK_CUR`,
    SEEK_END = `SEEK_END`,
}

seq FS::Dir::Type
{
    UNKNOWN   = `DT_UNKNOWN`,
    FIFO      = `DT_FIFO`,
    CHAR_DEV  = `DT_CHR`,
    DIR       = `DT_DIR`,
    BLOCK_DEV = `DT_BLK`,
    FILE      = `DT_REG`,
    LINK      = `DT_LNK`,
    UNIX_SOCK = `DT_SOCK`,
}


seq Net::AF
{
    UNSPEC = `AF_UNSPEC`,
    UNIX   = `AF_UNIX`,
    INET   = `AF_INET`,
}

seq Net::Sock
{
	STREAM	  = `SOCK_STREAM`,
	DGRAM	  = `SOCK_DGRAM`,
	RAW       = `SOCK_RAW`,
}

seq Net::Struct::sockaddr_in
    // in bit count format.
{
    sin_family = `offsetof(struct sockaddr_in, sin_family) * 8`, 
    sin_port   = `offsetof(struct sockaddr_in, sin_port  ) * 8`, 
    sin_addr   = `offsetof(struct sockaddr_in, sin_addr  ) * 8`,
}




